SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Extra OAuth client IDs accepted as RISC token audiences (e.g. Supabase Google Sign-In client), comma-separated
GOOGLE_RISC_AUDIENCES=
# Local path only — used by scripts/register-risc-stream.mjs (do not put the SA JSON on Vercel)
# GOOGLE_RISC_SERVICE_ACCOUNT_JSON=C:\path\to\risc-sa.json
# GOOGLE_RISC_RECEIVER_URL=https://www.mailmind.me/api/public/hooks/risc

AI_API_KEY=
AI_BASE_URL=https://api.imole.app/v1
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_TOKEN must also be set on Vercel for Gmail OAuth sync alerts
INBOUND_EMAIL_DOMAIN=mailmind.me
APP_ORIGIN=https://www.mailmind.me
APP_ORIGINS=http://localhost:5000,https://mailmind.me,https://www.mailmind.me
AI_ANALYSIS_MODEL=gpt-4o-mini
AI_BODY_MAX_CHARS=4000
AI_DAILY_ANALYZE_QUOTA=100
AI_DAILY_REPLY_QUOTA=20
AI_RATE_LIMIT_PER_MINUTE=10
GMAIL_SYNC_MAX_MESSAGES=100
GMAIL_SYNC_QUERY=in:inbox newer_than:14d
